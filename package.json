{
  "name": "jobos",
  "version": "0.1.0",
  "description": "Local-first, agent-native terminal operating system for job search and applications",
  "type": "module",
  "license": "MIT",
  "author": "JobOS contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpbangun/JobOS.git"
  },
  "homepage": "https://github.com/lpbangun/JobOS#readme",
  "bugs": {
    "url": "https://github.com/lpbangun/JobOS/issues"
  },
  "keywords": [
    "job-search",
    "career",
    "terminal",
    "local-first",
    "mcp",
    "agent"
  ],
  "files": [
    "src/",
    "samples/",
    ".agents/",
    ".claude/",
    "CLAUDE.md",
    "CODEX.md",
    "docs/jobos-tui.png",
    "docs/jobos-setup.png",
    "docs/jobos-chat.png",
    "docs/AGENT_GUIDE.md",
    "docs/CLAUDE.md",
    "docs/CODEX.md",
    "docs/CONFIGURATION.md",
    "docs/SAFETY_AND_STATE.md",
    "docs/mcp-compatibility-decision.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "jobos": "./src/cli.js"
  },
  "scripts": {
    "jobos": "node src/cli.js",
    "tui": "node src/cli.js tui",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "smoke": "node scripts/smoke.js",
    "smoke:live-form": "node scripts/smoke-live-form.js",
    "acp-demo": "node scripts/acp-demo.js",
    "acp-smoke": "node scripts/acp-smoke.js",
    "mcp-demo": "node scripts/mcp-demo.js",
    "check:release-security": "node scripts/check-release-security.js --format json",
    "test:w10": "node --test --test-concurrency=1 tests/w10-golden.test.js tests/w10-security-release.test.js tests/w10-docs-status.test.js tests/w10-mcp-compatibility.test.js",
    "release:evidence": "node scripts/release-evidence.js",
    "test:harness": "node --test --test-concurrency=1 tests/agent-harness-benchmark.test.js",
    "benchmark:harness": "node scripts/agent-harness-benchmark.js"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^6.45.0",
    "pdfjs-dist": "5.4.624",
    "react": "^19.2.8",
    "slice-ansi": "^9.0.0",
    "sql.js": "^1.12.0",
    "string-width": "^8.2.2",
    "strip-ansi": "^7.2.0",
    "yaml": "^2.8.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "playwright": "^1.61.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "playwright": "^1.61.1"
  }
}
